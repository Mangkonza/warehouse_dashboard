# ------------------------------------------------------------------------------
# Frontend Production Multi-Stage Dockerfile (Next.js Standalone)
# Service: WEB
# ------------------------------------------------------------------------------

# Stage 1: Install dependencies
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY warehouse_dashboard/package.json warehouse_dashboard/package-lock.json ./
RUN npm ci --fetch-retries=5

# Stage 2: Build the Next.js application
FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY warehouse_dashboard/ ./

# Build arguments for paths and endpoints
ARG BASE_PATH=""
ARG NEXT_PUBLIC_BASE_PATH=""
ARG NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
ARG NEXT_PUBLIC_USE_MOCK=""
ARG BACKEND_URL="http://backend:8000"

ENV BASE_PATH=${BASE_PATH:-$NEXT_PUBLIC_BASE_PATH} \
    NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH:-$BASE_PATH} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_USE_MOCK=${NEXT_PUBLIC_USE_MOCK} \
    BACKEND_URL=${BACKEND_URL} \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

# Stage 3: Minimal production runner
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

ARG BASE_PATH=""
ARG NEXT_PUBLIC_BASE_PATH=""
ARG NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
ARG NEXT_PUBLIC_USE_MOCK=""
ARG BACKEND_URL="http://backend:8000"

ENV BASE_PATH=${BASE_PATH:-$NEXT_PUBLIC_BASE_PATH} \
    NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH:-$BASE_PATH} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_USE_MOCK=${NEXT_PUBLIC_USE_MOCK} \
    BACKEND_URL=${BACKEND_URL}

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy static assets and standalone build output
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000' + (process.env.BASE_PATH || '') + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
