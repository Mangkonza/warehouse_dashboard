PORT=8000
NODE_ENV=development

# Database connection URL for PostgreSQL (Runtime app user with restricted privileges, CRUD only)
DATABASE_URL="postgresql://ku_app:ku_app_secret_2026@127.0.0.1:5432/ku_warehouse?schema=public"
DIRECT_URL="postgresql://ku_owner:ku_owner_secret_2026@127.0.0.1:5432/ku_warehouse?schema=public"

# Auth Session Configuration
AUTH_SESSION_SECRET=ku_warehouse_auth_session_secret_2026_dev_key
AUTH_SESSION_VERSION=1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Mock Authentication Flags
AUTH_MOCK_ENABLED=true
MOCK_TRUST_DB_ROLES=true
MOCK_SUPER_ADMIN_B0123456789_PASSWORD=Admin@1234
MOCK_SUPER_ADMIN_B0123456789_OTP=123456

# JWT Secret for Session tokens
JWT_SECRET=ku_warehouse_jwt_super_secret_key_2026

# Admin Nontri Accounts Whitelist
ADMIN_NONTRI_ACCOUNTS=b6520503525

# KU ALL-Login (OAuth 2.0 / OIDC + PKCE) Configuration
KU_AUTH_URL=https://alllogin.ku.ac.th
KU_CLIENT_ID=mock_ku_client_id
KU_CLIENT_SECRET=mock_ku_client_secret
KU_REDIRECT_URI=http://localhost:3000/auth/callback
