# ==============================================================================
# Frontend Environment Variables (.env.frontend)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Public Origin (REQUIRED in production)
PUBLIC_ORIGIN=https://warehouse.example.ku.ac.th

# App Base Path (leave empty for root, or set e.g. /warehouse)
BASE_PATH=

# Published port on host 127.0.0.1
FRONTEND_PORT=3000

# Backend service address in internal docker network (used by Next.js rewrites on server)
BACKEND_URL=http://backend:8000

# Client-side API URL: relative path to same-origin
NEXT_PUBLIC_API_URL=/api/v1

# Auth Session Secret (Min 32 characters)
AUTH_SESSION_SECRET=change_this_to_legacy_secret_at_least_32_characters
JWT_COOKIE_SECRET=change_this_to_legacy_secret_at_least_32_characters
