# ==============================================================================
# Backend API Service Environment (Express 5 + Prisma)
# Container: ku_warehouse_backend (Port 8000)
# ==============================================================================
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (Docker network: ku_warehouse_db)
DATABASE_URL=postgresql://ku_app:ku_app_secret_2026@host.docker.internal:5433/ku_warehouse?schema=public
DIRECT_URL=postgresql://ku_owner:ku_owner_secret_2026@host.docker.internal:5433/ku_warehouse?schema=public

# Auth & Session Security
AUTH_SESSION_SECRET=a8f4c91b7d3e2a0f8b1c4e9d7a2f0b8c4d9e1f7a2b0c4d8e9f1a2b3c4d5e6f7a
AUTH_SESSION_VERSION=1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://sac.eng.kps.ku.ac.th
JWT_SECRET=ku_warehouse_jwt_super_secret_key_2026

# Authentication Mode
AUTH_MOCK_ENABLED=false
MOCK_TRUST_DB_ROLES=false
ADMIN_NONTRI_ACCOUNTS=b6520503525,b0123456789,admin,superadmin