# ==========================================
# Database Configuration (Docker & Local)
# ==========================================
DB_PORT=5432
POSTGRES_DB=ku_warehouse

# Migration & DDL User (Owner)
POSTGRES_USER=ku_owner
POSTGRES_PASSWORD=change_this_to_owner_password

# Runtime App User (CRUD Only, No DDL)
APP_USER=ku_app
APP_PASSWORD=change_this_to_app_password

# Prisma / App Connection Strings
DIRECT_URL="postgresql://ku_owner:change_this_to_owner_password@127.0.0.1:5432/ku_warehouse?schema=public"
DATABASE_URL="postgresql://ku_app:change_this_to_app_password@127.0.0.1:5432/ku_warehouse?schema=public"

# ==========================================
# Backend Service Configuration
# ==========================================
PORT=8000
NODE_ENV=development
AUTH_SESSION_SECRET=change_this_to_a_random_32_character_secret_key
AUTH_SESSION_VERSION=1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Mock Authentication Flags (Local Development Only)
AUTH_MOCK_ENABLED=false
MOCK_TRUST_DB_ROLES=false
MOCK_SUPER_ADMIN_B0123456789_PASSWORD=placeholder_password
MOCK_SUPER_ADMIN_B0123456789_OTP=placeholder_otp
MOCK_SUPER_ADMIN_B6520503525_PASSWORD=placeholder_password
MOCK_SUPER_ADMIN_B6520503525_OTP=placeholder_otp
