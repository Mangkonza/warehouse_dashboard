# ==============================================================================
# KU Engineering Kamphaeng Saen Data Warehouse & Dashboard
# Production Docker Environment Variables Overview
# ==============================================================================
# Production uses 3 separate untracked env files referenced by docker-compose.yml:
#   - .env.frontend (copied from .env.frontend.example)
#   - .env.backend  (copied from .env.backend.example)
#   - .env.db       (copied from .env.db.example)
#
# Do NOT commit production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16) - used in .env.db and .env.backend
# ------------------------------------------------------------------------------
POSTGRES_DB=ku_warehouse
POSTGRES_USER=ku_owner
POSTGRES_PASSWORD=change_this_to_owner_password
APP_USER=ku_app
APP_PASSWORD=change_this_to_app_password

# ------------------------------------------------------------------------------
# 2. Backend Service - used in .env.backend
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=production
DATABASE_URL="postgresql://ku_app:change_this_to_app_password@db:5432/ku_warehouse?schema=public"
DIRECT_URL="postgresql://ku_owner:change_this_to_owner_password@db:5432/ku_warehouse?schema=public"
AUTH_SESSION_SECRET=change_this_to_a_random_32_character_secret_key
AUTH_SESSION_VERSION=1
CORS_ORIGIN=https://warehouse.example.ku.ac.th,http://localhost:3000
JWT_SECRET=change_this_jwt_secret

# ------------------------------------------------------------------------------
# 3. Frontend Service (Next.js 16) - used in .env.frontend
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000

# PUBLIC_ORIGIN: REQUIRED in production. Exact public origin terminated by reverse proxy.
PUBLIC_ORIGIN=https://warehouse.example.ku.ac.th

# BASE_PATH: Base path prefix (empty for root). Changing requires rebuilding frontend:
#   docker compose build frontend
BASE_PATH=

# Backend service address in private docker network
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Central SSO Configuration
# HS256 secret for USER_SESSION JWT cookies. Minimum 32 chars.
# Generate with: openssl rand -base64 48
JWT_COOKIE_SECRET=change_this_to_min_32_character_secret_key_for_sso_cookies

ENG_LOGIN_URL=https://office.eng.kps.ku.ac.th/eng-main/home
ENG_LOGOUT_URL=https://office.eng.kps.ku.ac.th/eng-main/useraccess
ENG_TOKEN_EXCHANGE_URL=https://office.eng.kps.ku.ac.th/eng-main/api/external/exchange-token
ENG_AUTH_ME_URL=https://eng.kps.ku.ac.th/me.php
ALL_LOGIN_STATUS_URL=https://eng.kps.ku.ac.th/verify.php
ENG_MAIN_ROLE_URL=https://office.eng.kps.ku.ac.th/eng-main/api/external/get-role
ENG_SYSTEM_ID=your_central_system_id_here

# TLS verification: unset or "true" in production.
CENTRAL_AUTH_STRICT_TLS=true
