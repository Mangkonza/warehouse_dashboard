# ==============================================================================
# Production Deployment Environment Configuration (Template)
# KU Engineering Kamphaeng Saen Data Warehouse & Executive Dashboard
# Copy this file to .env and configure your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=ku_warehouse
POSTGRES_USER=ku_owner
POSTGRES_PASSWORD=change_this_owner_password
APP_USER=ku_app
APP_PASSWORD=change_this_app_password

# ------------------------------------------------------------------------------
# 2. Backend API Service
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
NODE_ENV=production
DATABASE_URL="postgresql://ku_app:change_this_app_password@host.docker.internal:5432/ku_warehouse?schema=public"
DIRECT_URL="postgresql://ku_owner:change_this_owner_password@host.docker.internal:5432/ku_warehouse?schema=public"
AUTH_SESSION_SECRET=change_this_to_a_secret_at_least_32_characters_long
AUTH_SESSION_VERSION=1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://sac.eng.kps.ku.ac.th
JWT_SECRET=change_this_to_jwt_secret_key
AUTH_MOCK_ENABLED=false
MOCK_TRUST_DB_ROLES=false
ADMIN_NONTRI_ACCOUNTS=b6520503525,b0123456789,admin,superadmin

# ------------------------------------------------------------------------------
# 3. Frontend Dashboard Service (Next.js Standalone)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
BASE_PATH=/research_and_inovation
NEXT_PUBLIC_BASE_PATH=/research_and_inovation
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=http://ku_warehouse_backend:8000
JWT_COOKIE_SECRET=change_this_to_a_secret_at_least_32_characters_long
AUTH_SESSION_SECRET=change_this_to_a_secret_at_least_32_characters_long
