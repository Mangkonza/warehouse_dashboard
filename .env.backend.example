# ==============================================================================
# Backend (.env.backend) Configuration
# ==============================================================================

PORT=8000
NODE_ENV=production

# Database Connection (connecting to 'db' container over internal network)
DATABASE_URL="postgresql://ku_app:change_this_to_app_password@db:5432/ku_warehouse?schema=public"
DIRECT_URL="postgresql://ku_owner:change_this_to_owner_password@db:5432/ku_warehouse?schema=public"

# Auth & Session Configuration
AUTH_SESSION_SECRET=replace_with_backend_session_secret_min_32_characters
AUTH_SESSION_VERSION=1
CORS_ORIGIN=https://warehouse.example.ku.ac.th,http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace_with_backend_jwt_secret

# Mock Authentication Flags (Keep false in production)
AUTH_MOCK_ENABLED=false
MOCK_TRUST_DB_ROLES=false

# Central KU ALL-Login (OAuth 2.0 / OIDC legacy backend integration)
KU_AUTH_URL=https://alllogin.ku.ac.th
KU_CLIENT_ID=your_ku_client_id
KU_CLIENT_SECRET=your_ku_client_secret
KU_REDIRECT_URI=https://warehouse.example.ku.ac.th/auth/callback
ADMIN_NONTRI_ACCOUNTS=b6520503525
