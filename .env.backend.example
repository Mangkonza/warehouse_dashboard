# ==============================================================================
# Backend API Service Environment Template (Express 5 + Prisma)
# Copy this file to .env.backend and configure your secrets.
# Container: ku_warehouse_backend (Port 8000)
# ==============================================================================
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://ku_app:change_this_app_password@host.docker.internal:5432/ku_warehouse?schema=public
DIRECT_URL=postgresql://ku_owner:change_this_owner_password@host.docker.internal:5432/ku_warehouse?schema=public

# Auth & Session Security
AUTH_SESSION_SECRET=change_this_to_a_secret_at_least_32_characters_long
AUTH_SESSION_VERSION=1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://sac.eng.kps.ku.ac.th
JWT_SECRET=change_this_to_jwt_secret_key

# Authentication Mode
AUTH_MOCK_ENABLED=false
MOCK_TRUST_DB_ROLES=false
ADMIN_NONTRI_ACCOUNTS=b6520503525,b0123456789,admin,superadmin
