# ==============================================================================
# Frontend (.env.frontend) Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Origin & Routing (Production Reverse Proxy)
# ------------------------------------------------------------------------------
# PUBLIC_ORIGIN: REQUIRED in production. Must be the exact public origin (scheme + host[:port])
# where clients reach the application behind the reverse proxy. No trailing slash/path/query.
PUBLIC_ORIGIN=https://warehouse.example.ku.ac.th

# BASE_PATH: App-relative base path prefix (e.g. /warehouse or leave empty for root).
# NOTE: Changing BASE_PATH requires rebuilding the frontend image:
#   docker compose build frontend
BASE_PATH=

# Published port on host 127.0.0.1 (reverse proxy proxies to 127.0.0.1:3000)
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Backend Service Connectivity (Docker Internal Network)
# ------------------------------------------------------------------------------
# URL of the backend service within the docker network (resolved at build time into Next.js rewrites)
BACKEND_URL=http://backend:8000
INTERNAL_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Central Engineering ALL LOGIN + Intranet SSO Configuration
# ------------------------------------------------------------------------------
# HS256 secret for USER_SESSION JWT cookies. Minimum 32 characters.
# Generate with: openssl rand -base64 48
JWT_COOKIE_SECRET=replace_with_min_32_char_random_secret_string_here

# Central Portal URLs
ENG_LOGIN_URL=https://office.eng.kps.ku.ac.th/eng-main/home
ENG_LOGOUT_URL=https://office.eng.kps.ku.ac.th/eng-main/useraccess
ENG_TOKEN_EXCHANGE_URL=https://office.eng.kps.ku.ac.th/eng-main/api/external/exchange-token
ENG_AUTH_ME_URL=https://eng.kps.ku.ac.th/me.php
ALL_LOGIN_STATUS_URL=https://eng.kps.ku.ac.th/verify.php
ENG_MAIN_ROLE_URL=https://office.eng.kps.ku.ac.th/eng-main/api/external/get-role
ENG_SYSTEM_ID=your_central_system_id_here

# TLS verification for central auth endpoints:
# Unset or "true" enforces strict TLS certificate checking.
# "false" is strictly forbidden and rejected in production.
CENTRAL_AUTH_STRICT_TLS=true

# ------------------------------------------------------------------------------
# Legacy Authentication (ku_session) Secret
# ------------------------------------------------------------------------------
AUTH_SESSION_SECRET=replace_with_legacy_session_secret_at_least_32_characters
