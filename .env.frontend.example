# ==============================================================================
# Frontend Web Service Environment Template (Next.js 16 Standalone)
# Copy this file to .env.frontend and configure your secrets.
# Container: ku_warehouse_frontend (Port 3000)
# ==============================================================================
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Public Origin & Routing
PUBLIC_ORIGIN=http://localhost:3000
BASE_PATH=/research_and_inovation
NEXT_PUBLIC_BASE_PATH=/research_and_inovation
NEXT_PUBLIC_API_URL=/api/v1

# Backend Connectivity (Docker network: backend / ku_warehouse_backend)
BACKEND_URL=http://backend:8000

# Auth Secrets
JWT_COOKIE_SECRET=change_this_to_a_secret_at_least_32_characters_long
AUTH_SESSION_SECRET=change_this_to_a_secret_at_least_32_characters_long
